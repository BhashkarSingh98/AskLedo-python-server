PORT=8000

# Same Postgres as Nest (copy DATABASE_URL from server/.env).
DATABASE_URL=postgresql://searchmakesolution:searchmakesolution@localhost:5433/searchmakesolution

# Matching LLM: `vllm` keeps data on your infra, `gemini` sends it to Google. See docs/LLM.md.
LLM_PROVIDER=vllm
LLM_TIMEOUT_SECONDS=60
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
VLLM_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Cron: how often to look for consented queries, how long after consent to match, how many leads.
ROUTING_INTERVAL_SECONDS=60
ROUTING_DELAY_SECONDS=60
ROUTING_TOP_SOLUTIONERS=5
